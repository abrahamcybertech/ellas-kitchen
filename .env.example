# Ella's Kitchen Environment Configuration Template
# Duplicate this file to .env.local for local development or set in your production hosting provider.

# Application Environment
NODE_ENV=production
NEXT_PUBLIC_SITE_URL=https://ellaskitchen.ng

# Database Configuration
# Local embedded SQLite storage runs with zero external configuration out of the box.
SQLITE_DB_PATH=./data/ellas_kitchen.db

# Optional: Supabase / PostgreSQL Connection String
# When deploying to Supabase PostgreSQL, uncomment and provide your pooled transaction URL.
# DATABASE_URL=postgresql://postgres.yourproject:[YOUR-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# Paystack Online Payment Gateway (Nigeria)
# Obtain from your verified Paystack Dashboard (Settings -> API Keys & Webhooks)
# Test keys start with 'sk_test_' and 'pk_test_'. Live keys start with 'sk_live_' and 'pk_live_'.
PAYSTACK_SECRET_KEY=sk_test_replace_with_your_paystack_secret_key
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_replace_with_your_paystack_public_key

# JWT Session Secret for Staff Authentication
# Must be a high-entropy cryptographically random string (e.g., generated with `openssl rand -hex 32`)
JWT_SECRET=replace_with_a_64_character_crypto_random_secret_for_production_auth

# Security & CORS Origins (Optional)
ALLOWED_ORIGINS=https://ellaskitchen.ng
